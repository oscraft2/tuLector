NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Correo transaccional (invitaciones, alertas de cuota, pagos, bienvenida,
# comprobantes, confirmacion de leads). Sin estas dos variables, el sistema
# cae automaticamente a modo dev-log: los correos se imprimen por consola en
# vez de enviarse de verdad (ver src/lib/email.ts). Consigue el API key en
# https://resend.com/api-keys (requiere verificar un dominio propio primero
# para no quedar limitado al remitente sandbox onboarding@resend.dev). Ver
# docs/plan-correo-email.md para el detalle completo del sistema de correo.
RESEND_API_KEY=re_tu_api_key_aqui
RESEND_FROM_EMAIL=notificaciones@tudominio.com

# Google Analytics 4 (opcional). Sin esta variable, el snippet no se inyecta.
# Consegui el ID en https://analytics.google.com → Administrar → Crear propiedad
# → Web → copiar el "ID de medicion" (G-XXXXXXXXXX).
# Se excluye del APK nativo automaticamente (ver src/components/GoogleAnalytics.tsx).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Admin y pagos (solo servidor; nunca usar prefijo NEXT_PUBLIC para secretos).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# FLOW_API_KEY=
# FLOW_SECRET_KEY=
FLOW_SANDBOX=true
# DLOCAL_X_LOGIN=
# DLOCAL_X_TRANS_KEY=
# DLOCAL_SECRET_KEY=
DLOCAL_SANDBOX=true
